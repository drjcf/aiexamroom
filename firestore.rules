rules_version = '2';

// Adapted from @edai/lms for a PUBLIC, non-commercial audience.
// Divergence from the shipped LMS rules: learning (read, enroll, progress,
// certificates) is open to any visitor; authoring stays gated to curators.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function userRoles() {
      return request.auth.token.get('roles', [request.auth.token.get('role', '')]);
    }
    function hasAnyRole(roles) { return isAuthenticated() && userRoles().hasAny(roles); }
    function isOwner(uid)      { return isAuthenticated() && request.auth.uid == uid; }
    function isAdmin()         { return hasAnyRole(['admin', 'superadmin']); }
    function isAuthor()        { return hasAnyRole(['content_curator', 'admin', 'superadmin']); }

    match /lms_courses/{id} {
      allow read:   if resource.data.status == 'published' || isAuthor();
      allow create: if isAuthor() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.createdBy == request.auth.uid) || isAdmin()
                       || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollmentCount']));
      allow delete: if (isAuthenticated() && resource.data.createdBy == request.auth.uid) || isAdmin();
    }
    match /lms_lessons/{id} {
      allow read:  if true;                 // open reading
      allow write: if isAuthor();
    }
    match /lms_curricula/{id} {
      allow read:   if resource.data.status == 'published' || isAuthor();
      allow create: if isAuthor() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.createdBy == request.auth.uid) || isAdmin();
    }
    match /lms_enrollments/{id} {
      allow get: if resource == null || isOwner(resource.data.userId) || isAdmin();
      allow list, update: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /lms_curriculum_enrollments/{id} {
      allow get: if resource == null || isOwner(resource.data.userId) || isAdmin();
      allow list, update: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /lms_lesson_progress/{id} {
      allow get: if resource == null || isOwner(resource.data.userId) || isAdmin();
      allow list, update: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /lms_submissions/{id} {
      allow read:   if isOwner(resource.data.userId) || isAuthor();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAuthor();
      allow delete: if false;
    }
    match /lms_certificates/{id} {
      allow read:   if true;                // public certificate verification
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /lms_announcements/{id} {
      allow read:  if true;
      allow write: if isAuthor();
    }

    // Optional learner profile (created on account upgrade).
    match /users/{uid} {
      allow read:  if true;
      allow write: if isOwner(uid);
    }
  }
}
