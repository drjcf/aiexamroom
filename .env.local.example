# Firebase WEB config (PUBLIC client identifier — safe to commit).
# From: Firebase console > Project settings (gear) > General > Your apps > Web app.
# If no Web app is listed, click "</> Add app" to create one and copy its config.
# After editing, RESTART `npm run dev` (Next reads env only at startup).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aiexamroom.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aiexamroom
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aiexamroom.firebasestorage.app

# Admin scripts (migrate.mjs / set-author-claim.mjs) use a service account:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
